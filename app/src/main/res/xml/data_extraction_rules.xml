<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer: the Stips session token, the chats widget's copy of your chats, and which questions you
  answered anonymously (#14) never leave the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="anonymous_answers.xml" />
        <exclude domain="file" path="chats_widget.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="anonymous_answers.xml" />
        <exclude domain="file" path="chats_widget.json" />
    </device-transfer>
</data-extraction-rules>
