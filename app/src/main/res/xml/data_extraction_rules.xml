<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the Stips session token never leaves the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
