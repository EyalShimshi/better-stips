<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by JobScheduler for jobs that wait for a network (Android 14+), and to notice network changes (#1, #2). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phone notifications, only after the user turns them on (Settings or the notifications screen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the 15-minute notification check scheduled after a restart (JobInfo.setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android's "let Stips+ always run in the background?" question, so the checks aren't held back for hours (v0.11). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      No REQUEST_INSTALL_PACKAGES (v0.20, D-145): an app that downloads and installs APKs itself looks like malware to
      Play Protect. Updates open in the browser instead; RulesV20Test keeps it out.
    -->

    <!--
      Backups keep the settings across a reinstall, never the session (backup_rules, data_extraction_rules); the intro
      still shows after one (D-148).
    -->
    <application
        android:name=".StipsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.StipsPlus"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Stips question, profile and chat links. Not auto-verified: users turn it on under "Open by default". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="stips.co.il" />
                <data android:host="www.stips.co.il" />
                <data android:pathPrefix="/ask/" />
                <data android:pathPrefix="/profile/" />
                <data android:path="/messages" />
            </intent-filter>
            <!-- Launcher shortcuts: Hot and Chats (D-57). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          "Share → Stips+" (v0.19): text shared from another app goes to up to five chats, picked in Stips+'s own
          window. Plain text only, so pictures and files aren't offered to Stips+. Shows nothing itself, and is listed
          in the share sheet under the app's own name.
        -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".notify.NotificationCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The notification check every few minutes while the phone is awake (v0.11); only the app's own alarm calls it. -->
        <receiver
            android:name=".notify.NotificationAlarmReceiver"
            android:exported="false" />

        <!-- The "Hot right now" home-screen widget (D-51). -->
        <receiver
            android:name=".widget.HotWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="false"
            android:label="@string/hot_now">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hot_widget_info" />
        </receiver>

        <!-- The chats widget (#8). -->
        <receiver
            android:name=".widget.ChatsWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="false"
            android:label="@string/widget_chats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chats_widget_info" />
        </receiver>
    </application>
</manifest>
